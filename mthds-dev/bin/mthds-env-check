#!/usr/bin/env bash
# mthds-env-check — check mthds-agent installation and version
# Usage: mthds-env-check <min_version> [--codex]
# Output status codes (via stdout). Exactly one terminal status is emitted per
# run; update-check status and CODEX_CONFIG_NEEDS_SETUP are mutually exclusive
# (when --codex finds the config broken, that wins and the update-check output
# is suppressed — fixing the hook is the prerequisite, the user re-runs after).
#   MTHDS_AGENT_MISSING              — mthds-agent not on PATH
#   MTHDS_AGENT_VERSION_UNKNOWN      — could not parse installed version
#   MTHDS_AGENT_OUTDATED <inst> <req> — installed version too old
#   MTHDS_UPDATE_CHECK_FAILED ...    — update-check command failed (multi-line: status + error)
#   UPGRADE_AVAILABLE ...            — from mthds-agent update-check
#   JUST_UPGRADED ...                — from mthds-agent update-check
#   UP_TO_DATE                       — from mthds-agent update-check
#   CODEX_CONFIG_NEEDS_SETUP         — only with --codex; ~/.codex/ not set up for plugin
set -u
exec 2>/dev/null

REQUIRED="${1:-}"
PLATFORM_FLAG="${2:-}"
if [ -z "$REQUIRED" ]; then
  echo "MTHDS_ENV_CHECK_ERROR: missing min_version argument"
  exit 0
fi

if ! command -v mthds-agent &>/dev/null; then
  echo "MTHDS_AGENT_MISSING"
  exit 0
fi

# Version gate: block if mthds-agent is too old for this plugin
# NOTE: This bash semver comparison must stay in sync with the TypeScript
# implementation in mthds-js/src/installer/runtime/version-check.ts.
# Both implement major.minor.patch comparison. The bash version is
# intentionally simpler (no prerelease/build metadata support).
INSTALLED=$(mthds-agent --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
if [ -z "$INSTALLED" ]; then
  echo "MTHDS_AGENT_VERSION_UNKNOWN"
  exit 0
fi

IFS='.' read -r ia ib ic <<< "$INSTALLED"
IFS='.' read -r ra rb rc <<< "$REQUIRED"
if [ "$ia" -lt "$ra" ] 2>/dev/null ||
   { [ "$ia" -eq "$ra" ] && [ "$ib" -lt "$rb" ]; } 2>/dev/null ||
   { [ "$ia" -eq "$ra" ] && [ "$ib" -eq "$rb" ] && [ "$ic" -lt "$rc" ]; } 2>/dev/null; then
  echo "MTHDS_AGENT_OUTDATED $INSTALLED $REQUIRED"
  exit 0
fi

# Version is sufficient — check for available updates. Capture but defer
# printing: the Codex config check below can override this status, and we
# guarantee one terminal status per run so the preamble can't be tricked into
# matching UP_TO_DATE and skipping a needed Codex setup repair.
UPDATE_ERR_FILE=$(mktemp 2>/dev/null) || {
  echo "MTHDS_UPDATE_CHECK_FAILED exit=mktemp"
  exit 0
}
UPDATE_OUTPUT=$(mthds-agent update-check 2>"$UPDATE_ERR_FILE")
UPDATE_EXIT=$?
UPDATE_ERR=$(cat "$UPDATE_ERR_FILE" 2>/dev/null)
rm -f "$UPDATE_ERR_FILE"

# Codex-only: confirm ~/.codex/ is set up for the mthds plugin. A single
# `apply-config --check` covers all of it: sandbox network access, the
# [features] plugin_hooks key the bundled hook needs, and the absence of any
# obsolete hook entry. Without these the PostToolUse(apply_patch) validation
# hook silently does not run. We only check this when explicitly invoked from
# a Codex preamble (--codex), since the same binary serves Claude Code where
# this concern doesn't apply. When the check fails we suppress the deferred
# update-check output — the broken hook is the dominant blocker, and the user
# will see fresh update info on the next run.
if [ "$PLATFORM_FLAG" = "--codex" ]; then
  CODEX_ERR_FILE=$(mktemp 2>/dev/null) || CODEX_ERR_FILE=""
  if [ -n "$CODEX_ERR_FILE" ]; then
    if ! mthds-agent codex apply-config --check >/dev/null 2>"$CODEX_ERR_FILE"; then
      echo "CODEX_CONFIG_NEEDS_SETUP"
      # Surface the first line of stderr so support has a clue when this
      # status is reported by users — global `exec 2>/dev/null` (line 15)
      # would otherwise destroy the diagnostic.
      [ -s "$CODEX_ERR_FILE" ] && head -n 1 "$CODEX_ERR_FILE" | sed 's/^/# /'
      rm -f "$CODEX_ERR_FILE"
      exit 0
    fi
    rm -f "$CODEX_ERR_FILE"
  else
    if ! mthds-agent codex apply-config --check >/dev/null 2>&1; then
      echo "CODEX_CONFIG_NEEDS_SETUP"
      exit 0
    fi
  fi
fi

# Emit the deferred update-check status (only reached when the Codex check
# passed, or when --codex was not set).
if [ $UPDATE_EXIT -ne 0 ]; then
  echo "MTHDS_UPDATE_CHECK_FAILED exit=$UPDATE_EXIT"
  [ -n "$UPDATE_ERR" ] && echo "$UPDATE_ERR"
  [ -n "$UPDATE_OUTPUT" ] && echo "$UPDATE_OUTPUT"
elif [ -n "$UPDATE_OUTPUT" ]; then
  echo "$UPDATE_OUTPUT"
fi
